# Copy to .env.local and fill in real values. Never commit .env* with secrets.
# Required by the env schema (see lib/env.ts). Startup enforcement lands
# with the DB/auth wiring (issues 03-05); until then, fill these in so the
# schema validates once it is called at boot.
DATABASE_URL="postgres://focusflow:focusflow@localhost:5432/focusflow"
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# Planned (wired in later milestones; leave empty for now):
# Transactional email (issue 04): env-pluggable provider. `resend` is the
# default sender; without a key the app logs mail instead of sending it
# (registration and reset requests still succeed — non-blocking).
# EMAIL_PROVIDER="resend"
# EMAIL_API_KEY=""
# EMAIL_FROM="FocusFlow <noreply@example.com>"
# Test environments only: capture mail as JSON lines instead of delivering.
# EMAIL_PROVIDER="outbox"
# EMAIL_OUTBOX_DIR="/tmp/focusflow-mail-outbox"
# Base URL for emailed links (verify/reset) and secure-cookie mode
# (https APP_URL => __Secure- cookie + Secure flag).
# APP_URL="http://localhost:3000"
# Scrubbed error monitoring DSN (e.g. Sentry)
# ERROR_DSN=""

# Observability (issue 06): structured log level
# (fatal, error, warn, info, debug, trace).
LOG_LEVEL="info"
