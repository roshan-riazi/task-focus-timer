# Copy to .env.local and fill in real values. Never commit .env* with secrets.
# VPS-only deploys (ADR-0005): the compose stack reads this file (or the host
# env). Local dev uses the container Postgres default below; VPS production
# MUST set AUTH_SECRET, APP_URL (public https origin), and POSTGRES_PASSWORD.
DATABASE_URL="postgres://focusflow:focusflow@localhost:5432/focusflow"
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# Planned (wired in later milestones; leave empty for now):
# Transactional email (issue 04): env-pluggable provider. `resend` is the
# default sender; without a key the app logs mail instead of sending it
# (registration and reset requests still succeed — non-blocking).
# EMAIL_PROVIDER="resend"
# EMAIL_API_KEY=""
# EMAIL_FROM="FocusFlow <noreply@example.com>"
# Test environments only: capture mail as JSON lines instead of delivering.
# EMAIL_PROVIDER="outbox"
# EMAIL_OUTBOX_DIR="/tmp/focusflow-mail-outbox"
# Base URL for emailed links (verify/reset), secure-cookie mode
# (https APP_URL => __Secure- cookie + Secure flag), and the CSRF origin
# gate (issue 05): browser mutations must carry an Origin/Referer matching
# this origin, so production MUST set the public https origin here.
# APP_URL="http://localhost:3000"
# Scrubbed error monitoring DSN (e.g. Sentry)
# ERROR_DSN=""

# VPS production extras (compose reads these; see RUNBOOK §1):
# Container Postgres password (compose `db` service; default is dev-only).
# POSTGRES_PASSWORD="replace-with-a-long-random-string"
# Pinned image tag (vps-deploy.sh sets IMAGE_TAG=<git-sha> automatically).
# IMAGE_TAG="latest"
# Host backup directory mounted at /backups (RUNBOOK §4, 30-day expiry).
# BACKUP_DIR="./backups"

# Observability (issue 06): structured log level
# (fatal, error, warn, info, debug, trace).
LOG_LEVEL="info"
