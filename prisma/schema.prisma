generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  active
  completed
  archived
}

enum IntervalType {
  focus
  short_break
  long_break
}

enum SessionStatus {
  running
  paused
  completed
  cancelled
}

model User {
  id         String           @id @default(uuid()) @db.Uuid
  email      String           @unique @db.VarChar(255)
  timezone   String           @default("UTC") @db.VarChar(64)
  // Issue 04 (credentials): scrypt/bcrypt hash, null for future
  // passwordless-only accounts. The service layer requires it non-null
  // for credentials users; emailVerified drives the verification nag.
  name          String?    @db.VarChar(255)
  image         String?
  passwordHash  String?    @map("password_hash") @db.Text
  emailVerified DateTime?  @map("email_verified") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  settings   UserSettings?
  tasks      Task[]
  timerSessions TimerSession[]
  cycleState FocusCycleState?
  // Auth.js v5 adapter relations (DB sessions, ADR-0002). `sessions` here
  // is the adapter Session model; timer rows live under `timerSessions`.
  accounts               Account[]
  sessions               Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model UserSettings {
  userId                   String   @id @map("user_id") @db.Uuid
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusDurationSeconds     Int      @default(1500) @map("focus_duration_seconds")
  shortBreakSeconds        Int      @default(300) @map("short_break_seconds")
  longBreakSeconds         Int      @default(900) @map("long_break_seconds")
  intervalsBeforeLongBreak Int      @default(4) @map("intervals_before_long_break")
  autoStartBreaks          Boolean  @default(false) @map("auto_start_breaks")
  autoStartFocus           Boolean  @default(false) @map("auto_start_focus")
  soundEnabled             Boolean  @default(true) @map("sound_enabled")
  soundPreset              String   @default("chime") @map("sound_preset") @db.VarChar(32)
  soundVolume              Int      @default(80) @map("sound_volume")
  notificationsEnabled     Boolean  @default(false) @map("notifications_enabled")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_settings")
}

model Task {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(200)
  notes       String?        @db.VarChar(2000)
  category    String?        @db.VarChar(50)
  status      TaskStatus     @default(active)
  position    Float
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime?      @map("completed_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  timerSessions TimerSession[]

  @@index([userId, status, position], map: "tasks_user_status_position_idx")
  @@map("tasks")
}

model TimerSession {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId                  String?       @map("task_id") @db.Uuid
  task                    Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskTitleSnapshot       String?       @map("task_title_snapshot") @db.VarChar(200)
  categorySnapshot        String?       @map("category_snapshot") @db.VarChar(50)
  intervalType            IntervalType  @map("interval_type")
  status                  SessionStatus @default(running)
  plannedDurationSeconds  Int           @map("planned_duration_seconds")
  actualDurationSeconds   Int?          @map("actual_duration_seconds")
  startedAt               DateTime      @map("started_at") @db.Timestamptz(6)
  expectedEndAt           DateTime      @map("expected_end_at") @db.Timestamptz(6)
  pausedAt                DateTime?     @map("paused_at") @db.Timestamptz(6)
  accumulatedPauseSeconds Int           @default(0) @map("accumulated_pause_seconds")
  completedAt             DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId], map: "timer_sessions_one_active_per_user", where: raw("\"status\" IN ('running', 'paused')"))
  @@index([userId, startedAt], map: "timer_sessions_user_started_idx")
  @@map("timer_sessions")
}

model FocusCycleState {
  userId              String   @id @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedFocusCount Int      @default(0) @map("completed_focus_count")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("focus_cycle_state")
}

// Auth.js v5 adapter tables (issue 04, ADR-0002: database sessions keep the
// single-DB purge story). Shapes follow the Auth.js Prisma reference so
// `@auth/prisma-adapter` works unmodified; table names are app-prefixed to
// avoid confusion with domain tables. Credentials themselves (hashing,
// verification, reset) are app-managed — Auth.js documents the Credentials
// provider as database-less by design — while sessions live here.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

// Single-use email-flow tokens (issue 04). Only SHA-256 hashes are stored;
// raw tokens travel by email only. One live token per user per flow: minting
// replaces unconsumed predecessors.
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "email_verification_tokens_user_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "password_reset_tokens_user_idx")
  @@map("password_reset_tokens")
}

// DB-backed rate-limit hits (issue 05, ADR-0003: portable fixed windows, no
// Redis in the MVP). One row per guarded attempt; the store counts rows
// inside the window and lazily prunes expired rows on each hit. `key` embeds
// the endpoint bucket + caller IP only — never emails or user content.
model RateLimitHit {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([key, createdAt], map: "rate_limit_hits_key_created_idx")
  @@map("rate_limit_hits")
}
